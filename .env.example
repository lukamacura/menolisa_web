# MenoLisa — environment template. Copy to .env.local and fill in.
# Production values live in the Vercel project settings; keep the two in sync.
# Every key below is read somewhere in the codebase — nothing here is decorative.

# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ──────────────────────────────────────────────────────
# Embeddings (text-embedding-3-large) + chat (gpt-4o-mini).
OPENAI_API_KEY=

# ── URLs ────────────────────────────────────────────────────────
# The one base-URL variable. Must be in Supabase Auth → Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The only plan: $59, recurring week x 8. See lib/pricing.ts.
STRIPE_PRICE_8WEEK=
STRIPE_WEBHOOK_SECRET=
# 50%-off coupon applied by the referral system.
STRIPE_REFERRAL_COUPON_ID=

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
# Optional. Unset = no internal alerts.
ADMIN_NOTIFICATION_EMAIL=

# ── Cron + admin ────────────────────────────────────────────────
# Protects /api/cron/*.
CRON_SECRET=
# Gate for /api/admin/stats. No fallback — unset means the panel is closed.
ADMIN_PANEL_PASSWORD=

# ── Mobile app ──────────────────────────────────────────────────
# Signs the mobile → web session handoff JWT.
MOBILE_WEB_HANDOFF_SECRET=
# Verifies Apple IAP receipts.
APPLE_IAP_SHARED_SECRET=
# "true" re-enables the web product surfaces. Absent = mobile-only.
NEXT_PUBLIC_WEB_APP_ENABLED=

# ── Meta Pixel / Conversions API ────────────────────────────────
# Events Manager → Settings. Server-only. Unset = browser-only Purchase events.
META_CAPI_ACCESS_TOKEN=
# Optional; lib/metaPixel.ts has a default.
NEXT_PUBLIC_META_PIXEL_ID=
# Optional. Leave unset in production.
META_CAPI_TEST_EVENT_CODE=

# ── Media ───────────────────────────────────────────────────────
# Optional; lib/plan/catalog.ts has a default.
EXERCISE_MEDIA_BASE=
