# MenoLisa — environment template. Copy to .env.local and fill in.
# Production values live in the Vercel project settings; keep the two in sync.
# Every key below is read somewhere in the codebase — nothing here is decorative.

# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ──────────────────────────────────────────────────────
# Embeddings (text-embedding-3-large) + chat (gpt-4o-mini).
OPENAI_API_KEY=

# ── URLs ────────────────────────────────────────────────────────
# The one base-URL variable. Must be in Supabase Auth → Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The only plan: $59, recurring week x 8. See lib/pricing.ts.
STRIPE_PRICE_8WEEK=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
# Optional. Unset = no internal alerts.
ADMIN_NOTIFICATION_EMAIL=

# ── Cron + admin ────────────────────────────────────────────────
# Protects /api/cron/*.
CRON_SECRET=
# Gate for /api/admin/stats. No fallback — unset means the panel is closed.
ADMIN_PANEL_PASSWORD=

# ── Mobile app ──────────────────────────────────────────────────
# Signs the mobile → web session handoff JWT.
MOBILE_WEB_HANDOFF_SECRET=
# Verifies Apple IAP receipts.
APPLE_IAP_SHARED_SECRET=

# ── Meta Pixel / Conversions API ────────────────────────────────
# Events Manager → Settings. Server-only. Unset = browser-only Purchase events.
META_CAPI_ACCESS_TOKEN=
# Set this explicitly in production. lib/metaPixel.ts falls back to a literal,
# and a wrong or stale id sends every browser AND server event into a dataset
# nobody reads - with no error anywhere. Must match Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# Optional, and MUST be unset in production: with it set, every Conversions API
# event lands in Events Manager's Test Events tab only and never in the dataset
# ads optimize against.
META_CAPI_TEST_EVENT_CODE=

# ── Media ───────────────────────────────────────────────────────
# Optional; lib/plan/catalog.ts has a default.
EXERCISE_MEDIA_BASE=
# Optional; lib/plan/catalog.ts has a default (the relaxation-audio bucket).
RELAXATION_MEDIA_BASE=

# ── Mobile app version gate (GET /api/app-version) ──────────────
# Both optional - app/api/app-version/route.ts carries a default for each, and
# the defaults are what ships. Set them to move the gate without a deploy of the
# route: MOBILE_MIN_VERSION is the hard floor (below it the app shows
# UpdateRequiredScreen and refuses to run), MOBILE_LATEST_VERSION is the newest
# build in the stores (drives the soft "update available" card).
# Bump MOBILE_LATEST_VERSION on every store release.
MOBILE_MIN_VERSION=
MOBILE_LATEST_VERSION=
